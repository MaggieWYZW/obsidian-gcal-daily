{
  "name": "gcal-daily",
  "version": "1.1.1",
  "private": true,
  "description": "Obsidian plugin: insert a day's Google Calendar schedule into notes",
  "main": "main.js",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "smoke": "node esbuild.config.mjs smoke && node smoke.cjs",
    "check": "node esbuild.config.mjs check && node check.cjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.20.0",
    "obsidian": "^1.14.4",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "ical.js": "^2.2.1"
  }
}
